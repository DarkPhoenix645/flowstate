<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <!--
    Warehouse files live on the namenode. Derby stays the metastore
    database (javax.jdo.option.ConnectionURL below).
    URI picked by the Hive-on-HDFS spike: same authority as fs.defaultFS.
  -->
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>hdfs://namenode:9000/user/hive/warehouse</value>
  </property>
  <property>
    <name>hive.metastore.uris</name>
    <value>thrift://hive-metastore:9083</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=/opt/hive/data/metastore_db;create=true</value>
  </property>
  <!--
    HiveServer2 requires scratch dir mode 0733. Hadoop applies the
    process umask, so 0733 becomes 0755 and startup retries forever.
    file:// keeps scratch on the container disk. The warehouse URI above
    is what puts table files on HDFS.
  -->
  <property>
    <name>hive.exec.scratchdir</name>
    <value>file:///tmp/hive</value>
  </property>
  <property>
    <name>hive.exec.local.scratchdir</name>
    <value>/tmp/hive</value>
  </property>
  <property>
    <name>hive.user.install.directory</name>
    <value>file:///opt/hive/install_dir</value>
  </property>
  <property>
    <name>fs.permissions.umask-mode</name>
    <value>000</value>
  </property>
  <!--
    HiveServer2 calls get_current_notificationEventId on startup.
    The metastore refuses that call for user hive unless this is false.
  -->
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>
  <!--
    Image defaults. Tez stays in-process so a SELECT does not need YARN.
    doAs stays off so HiveServer2 uses its own HDFS user.
  -->
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.execution.engine</name>
    <value>tez</value>
  </property>
  <property>
    <name>tez.local.mode</name>
    <value>true</value>
  </property>
  <property>
    <name>tez.runtime.optimize.local.fetch</name>
    <value>true</value>
  </property>
  <property>
    <name>hive.tez.exec.inplace.progress</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.exec.submit.local.task.via.child</name>
    <value>false</value>
  </property>
  <property>
    <name>mapreduce.framework.name</name>
    <value>local</value>
  </property>
</configuration>
