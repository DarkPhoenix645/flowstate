meta {
  name: Start MapReduce demand
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/runs
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "kind": "analytics",
    "job": "demand_hotspots",
    "engine": "mapreduce",
    "params": {}
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 202 && body.run_id) {
    bru.setVar("runId", String(body.run_id));
  }
}

docs {
  Q1 on YARN. engine mapreduce also starts cancellation_analysis,
  ridership_trends, or cross_modal. Omit engine to stay on Spark.
  The script stores runId for Get run.
}
