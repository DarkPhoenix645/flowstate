meta {
  name: List runs
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/runs
  body: none
  auth: none
}

params:query {
  kind: analytics
  limit: 50
}

docs {
  Optional kind and status filters. limit is 1 to 100.
  Pass next_cursor as cursor for the next page. The first page omits cursor.
}
