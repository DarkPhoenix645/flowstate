# Copy to .env and fill in. Never commit .env.

# Kaggle (kagglehub) — token from https://www.kaggle.com/settings/api
# Do not use legacy KAGGLE_USERNAME / KAGGLE_KEY.
KAGGLE_API_TOKEN=

# OpenSky, read by Settings.opensky_clients(). Up to 10 pairs.
# Pair 1: FLOWSTATE_OPENSKY_CLIENT_ID and FLOWSTATE_OPENSKY_CLIENT_SECRET.
# Pairs 2-10 use the _2, ... _9, _10 suffix.
# A full alignment-window fetch is about 16,140 flight credits.
# One client has 4,000 credits per day. Add pairs to parallelise and finish in one run.
FLOWSTATE_OPENSKY_CLIENT_ID=
FLOWSTATE_OPENSKY_CLIENT_SECRET=
# FLOWSTATE_OPENSKY_CLIENT_ID_2=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_2=
# FLOWSTATE_OPENSKY_CLIENT_ID_3=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_3=
# FLOWSTATE_OPENSKY_CLIENT_ID_4=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_4=
# FLOWSTATE_OPENSKY_CLIENT_ID_5=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_5=
# FLOWSTATE_OPENSKY_CLIENT_ID_6=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_6=
# FLOWSTATE_OPENSKY_CLIENT_ID_7=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_7=
# FLOWSTATE_OPENSKY_CLIENT_ID_8=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_8=
# FLOWSTATE_OPENSKY_CLIENT_ID_9=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_9=
# FLOWSTATE_OPENSKY_CLIENT_ID_10=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_10=

# Host-side Python (ingest, Kafka producer). Spark/Hadoop/Hive run in Compose.
FLOWSTATE_DATA_DIR=data
FLOWSTATE_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
FLOWSTATE_SPARK_MASTER=spark://spark:7077
# Model config in Compose Postgres. Blank uses this local URL.
FLOWSTATE_CONFIG_DATABASE_URL=postgresql://flowstate:flowstate@127.0.0.1:5432/flowstate
# FLOWSTATE_API_HOST=127.0.0.1
# FLOWSTATE_API_PORT=8090
# Metro station and airport pins. One lookup per query, cached in data/geocode/.
FLOWSTATE_GOOGLE_MAPS_API_KEY=

# BMTC boarding prior (#40, ADR-0012). A run reads these from Postgres,
# not from these variables. Change them with PUT /api/model-config/resample_config.
# Evidence: docs/bmtc-boarding-prior.md. Setup: docs/model-config.md.
# 4.6m is a model choice inside a press-reported 4.8m (2025) and the
# CAG 3.31m (FY2019-20); test 4.0m and 4.8m; 3.31m replays FY2019-20.
#FLOWSTATE_ASSUMED_WEEKDAY_BOARDINGS=4600000
# 41.3 is seats (Karnataka Economic Survey 2018-19), never seats plus standing.
#FLOWSTATE_ASSUMED_BUS_CAPACITY=41.3
# Synthetic guardrail, not a statutory or observed peak load; test 1.0 / 1.2 / 1.4.
#FLOWSTATE_ASSUMED_MAX_LOAD_FACTOR=1.4
# Stays 1.0: no citywide causal substitution coefficient for the Yellow Line.
#FLOWSTATE_METRO_SUBSTITUTION_MULTIPLIER=1.0
# metro_ridehail_blend until a versioned 24-hour BMTC table exists.
#FLOWSTATE_BUS_HOUR_PROFILE=metro_ridehail_blend
# Combined peak windows (08-11, 17-20) hold 47-51% of daily demand (Gadepalli 2022).
#FLOWSTATE_BUS_PEAK_SHARE_LOW=0.47
#FLOWSTATE_BUS_PEAK_SHARE_HIGH=0.51
# Citywide historical trip-length soft targets (CMP/RITES 2016; Gadepalli 2020).
#FLOWSTATE_BUS_TRIP_LENGTH_KM_LOW=10.7
#FLOWSTATE_BUS_TRIP_LENGTH_KM_HIGH=10.9
