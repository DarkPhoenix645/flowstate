# Copy to .env and fill in. Never commit .env.

# Kaggle (kagglehub) — token from https://www.kaggle.com/settings/api
# Do not use legacy KAGGLE_USERNAME / KAGGLE_KEY.
KAGGLE_API_TOKEN=

# OpenSky, read by Settings.opensky_clients(). Up to 10 pairs.
# Pair 1: FLOWSTATE_OPENSKY_CLIENT_ID and FLOWSTATE_OPENSKY_CLIENT_SECRET.
# Pairs 2-10 use the _2, ... _9, _10 suffix.
# A full alignment-window fetch is about 16,140 flight credits.
# One client has 4,000 credits per day. Add pairs to parallelise and finish in one run.
FLOWSTATE_OPENSKY_CLIENT_ID=
FLOWSTATE_OPENSKY_CLIENT_SECRET=
# FLOWSTATE_OPENSKY_CLIENT_ID_2=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_2=
# FLOWSTATE_OPENSKY_CLIENT_ID_3=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_3=
# FLOWSTATE_OPENSKY_CLIENT_ID_4=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_4=
# FLOWSTATE_OPENSKY_CLIENT_ID_5=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_5=
# FLOWSTATE_OPENSKY_CLIENT_ID_6=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_6=
# FLOWSTATE_OPENSKY_CLIENT_ID_7=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_7=
# FLOWSTATE_OPENSKY_CLIENT_ID_8=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_8=
# FLOWSTATE_OPENSKY_CLIENT_ID_9=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_9=
# FLOWSTATE_OPENSKY_CLIENT_ID_10=
# FLOWSTATE_OPENSKY_CLIENT_SECRET_10=

# Host-side Python (ingest, Kafka producer). Spark/Hadoop/Hive run in Compose.
FLOWSTATE_DATA_DIR=data
FLOWSTATE_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
FLOWSTATE_SPARK_MASTER=spark://spark:7077
# Metro station and airport pins. One lookup per query, cached in data/geocode/.
FLOWSTATE_GOOGLE_MAPS_API_KEY=
